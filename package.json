{
  "name": "metavm",
  "version": "1.4.5",
  "author": "Timur Shemsedinov <timur.shemsedinov@gmail.com>",
  "license": "MIT",
  "description": "Metarhia script loader for Node.js vm and browsers",
  "keywords": [
    "node.js",
    "metarhia",
    "vm",
    "sandbox",
    "context",
    "script",
    "container",
    "isolation"
  ],
  "main": "metavm.js",
  "browser": {
    "./metavm.js": "./metavm.mjs"
  },
  "types": "metavm.d.ts",
  "readmeFilename": "README.md",
  "exports": {
    ".": {
      "browser": {
        "types": "./metavm.d.mts",
        "default": "./metavm.mjs"
      },
      "node": {
        "types": "./metavm.d.ts",
        "default": "./metavm.js"
      },
      "default": "./metavm.js"
    }
  },
  "files": [
    "lib/",
    "metavm.js",
    "metavm.mjs",
    "metavm.d.ts",
    "metavm.d.mts",
    "virtual.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metarhia/metavm.git"
  },
  "bugs": {
    "url": "https://github.com/metarhia/metavm/issues",
    "email": "timur.shemsedinov@gmail.com"
  },
  "homepage": "https://metarhia.com",
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/tshemsedinov"
  },
  "scripts": {
    "build": "metarhia-build lib",
    "test": "npm run build && npm run lint && npm run types && node --test",
    "types": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check \"**/*.js\" \"test/**/*.mjs\" \"**/*.json\" \"**/*.md\" \"**/*.ts\" \"**/*.mts\"",
    "fix": "eslint . --fix && prettier --write \"**/*.js\" \"test/**/*.mjs\" \"**/*.json\" \"**/*.md\" \"**/*.ts\" \"**/*.mts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-metarhia": "^10.0.1",
    "metarhia-build": "^0.0.3",
    "metaskills": "^1.0.6",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
